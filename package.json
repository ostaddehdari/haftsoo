{
  "name": "haftsoo",
  "version": "0.16.0-stage.16",
  "private": true,
  "description": "Haftsoo national classifieds marketplace monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace @haftsoo/web",
    "build:api": "npm run build --workspace @haftsoo/api",
    "build:contracts": "npm run build --workspace @haftsoo/contracts",
    "dev:web": "npm run dev --workspace @haftsoo/web",
    "dev:api": "npm run dev --workspace @haftsoo/api",
    "lint": "node scripts/lint.mjs",
    "format:check": "node scripts/format-check.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "commitlint": "node scripts/commitlint.mjs",
    "verify:stage1": "node scripts/verify-stage-01.mjs",
    "verify:stage2": "node scripts/verify-stage-02.mjs",
    "verify:stage3": "node scripts/verify-stage-03.mjs",
    "verify:stage4": "node scripts/verify-stage-04.mjs",
    "verify:stage5": "node scripts/verify-stage-05.mjs",
    "verify:stage6": "node scripts/verify-stage-06.mjs",
    "verify:stage7": "node scripts/verify-stage-07.mjs",
    "verify:stage8": "node scripts/verify-stage-08.mjs",
    "verify:stage9": "node scripts/verify-stage-09.mjs",
    "verify:stage10": "node scripts/verify-stage-10.mjs",
    "verify:stage11": "node scripts/verify-stage-11.mjs",
    "verify:stage12": "node scripts/verify-stage-12.mjs",
    "verify:stage13": "node scripts/verify-stage-13.mjs",
    "verify:stage14": "node scripts/verify-stage-14.mjs",
    "verify:stage15": "node scripts/verify-stage-15.mjs",
    "verify:stage16": "node scripts/verify-stage-16.mjs",
    "db:migrate": "node scripts/db-migrate.mjs up",
    "db:rollback": "node scripts/db-migrate.mjs down",
    "db:status": "node scripts/db-migrate.mjs status",
    "database:contract": "node scripts/database-contract.mjs",
    "catalog:contract": "node scripts/catalog-contract.mjs",
    "catalog:validate": "node scripts/catalog-import.mjs fixtures/catalog/sample-catalog.json",
    "geo:contract": "node scripts/geo-contract.mjs",
    "geo:validate": "node scripts/geo-import.mjs fixtures/geo/sample-geo.json",
    "geo:national:build": "node scripts/geo-national-build.mjs",
    "geo:national:contract": "node scripts/geo-national-contract.mjs",
    "geo:national:qa": "node scripts/geo-national-qa.mjs --check",
    "search:contract": "node scripts/search-contract.mjs",
    "search:bootstrap": "node scripts/opensearch-bootstrap.mjs",
    "search:quality": "node scripts/search-relevance-performance.mjs",
    "map:contract": "node scripts/map-gis-contract.mjs",
    "submission:contract": "node scripts/submission-contract.mjs",
    "media:contract": "node scripts/media-contract.mjs",
    "listing:contract": "node scripts/listing-lifecycle-contract.mjs",
    "security:baseline": "node scripts/security-baseline.mjs",
    "test:security": "npm run test --workspace @haftsoo/api",
    "test:capacity": "node scripts/test-capacity.mjs",
    "verify:install": "node scripts/verify-install-assets.mjs",
    "verify:all": "npm run verify:stage1 && npm run verify:stage2 && npm run verify:stage3 && npm run verify:stage4 && npm run verify:stage5 && npm run verify:stage6 && npm run verify:stage7 && npm run verify:stage8 && npm run verify:stage9 && npm run verify:stage10 && npm run verify:stage11 && npm run verify:stage12 && npm run verify:stage13 && npm run verify:stage14 && npm run verify:stage15 && npm run verify:stage16 && npm run verify:install"
  },
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  }
}
