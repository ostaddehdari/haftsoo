{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "Haftsoo Design System",
    "version": "0.3.0",
    "direction": "rtl",
    "baseFontSize": 16
  },
  "color": {
    "brand": { "50": "#fff7f7", "100": "#fdeaea", "500": "#c93636", "600": "#a62626", "700": "#851f1f" },
    "neutral": { "0": "#ffffff", "50": "#fafafa", "100": "#f4f4f5", "200": "#e4e4e7", "300": "#d4d4d8", "400": "#a1a1aa", "500": "#71717a", "600": "#52525b", "700": "#3f3f46", "800": "#27272a", "900": "#18181b", "950": "#09090b" },
    "semantic": { "success": "#15803d", "warning": "#b45309", "danger": "#b91c1c", "info": "#1d4ed8" },
    "light": { "surface": "#ffffff", "surfaceMuted": "#f4f4f5", "content": "#27272a", "contentMuted": "#71717a", "border": "#e4e4e7" },
    "dark": { "surface": "#18181b", "surfaceMuted": "#27272a", "content": "#fafafa", "contentMuted": "#a1a1aa", "border": "#3f3f46" }
  },
  "space": { "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64 },
  "radius": { "sm": 4, "md": 8, "lg": 12, "xl": 16, "pill": 999 },
  "shadow": { "sm": "0 1px 2px rgba(0,0,0,.08)", "md": "0 8px 24px rgba(0,0,0,.12)", "modal": "0 24px 64px rgba(0,0,0,.28)" },
  "typography": {
    "family": "Vazirmatn, IRANSansX, Tahoma, Arial, sans-serif",
    "weight": { "regular": 400, "medium": 500, "bold": 700 },
    "size": { "caption": 12, "bodySmall": 14, "body": 16, "titleSmall": 18, "title": 24, "display": 32 },
    "lineHeight": { "compact": 1.5, "body": 1.8, "relaxed": 2 }
  },
  "breakpoint": { "mobile": 0, "tablet": 520, "desktop": 768, "wide": 1200 },
  "motion": { "instant": 0, "fast": 120, "normal": 240, "slow": 360, "easing": "cubic-bezier(.2,0,0,1)" },
  "layer": { "base": 0, "sticky": 100, "dropdown": 300, "overlay": 1000, "modal": 1100, "toast": 1200 }
}

