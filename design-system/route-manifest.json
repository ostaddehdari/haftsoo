{
  "version": "0.10.0",
  "basePath": "/haftsoo",
  "routes": [
    { "id": "home", "path": "/", "family": "discovery", "auth": false, "states": ["default", "city-search", "offline"] },
    { "id": "listing", "path": "/s/:city/:category?", "family": "search", "auth": false, "states": ["skeleton", "results", "no-result", "error", "map", "infinite", "pagination"] },
    { "id": "post", "path": "/v/:slug/:token", "family": "post", "auth": false, "states": ["loading", "ready", "expired", "removed", "contact-revealed"] },
    { "id": "submit", "path": "/new", "family": "submission", "auth": true, "states": ["category", "details", "location", "media", "contact", "preview", "autosaving", "offline", "success", "rejected"] },
    { "id": "login", "path": "/auth/login", "family": "identity", "auth": false, "states": ["phone", "otp", "resend", "blocked", "success"] },
    { "id": "chat", "path": "/chat/:conversation?", "family": "communication", "auth": true, "states": ["inbox", "empty", "conversation", "sending", "offline", "reconnecting", "blocked", "reported"] },
    { "id": "account", "path": "/my", "family": "account", "auth": true, "states": ["overview", "profile", "preferences", "identity", "privacy", "export-pending", "deletion-pending"] },
    { "id": "notifications", "path": "/my/notifications", "family": "communication", "auth": true, "states": ["loading", "ready", "unread", "empty", "archived"] },
    { "id": "notification-settings", "path": "/my/settings/notifications", "family": "communication", "auth": true, "states": ["channels", "categories", "quiet-hours", "saved"] },
    { "id": "moderation-admin", "path": "/admin/moderation", "family": "internal", "auth": true, "states": ["loading", "queue", "selected", "appeal", "resolved", "empty"] },
    { "id": "moderation-operations", "path": "/admin/moderation/operations", "family": "internal", "auth": true, "states": ["loading", "healthy", "at-risk", "breached", "claimed", "escalated", "empty"] },
    { "id": "crm-admin", "path": "/admin/crm", "family": "internal", "auth": true, "states": ["loading", "queue", "assigned", "waiting-customer", "resolved", "customer-360", "empty"] },
    { "id": "my-posts", "path": "/my/posts", "family": "account", "auth": true, "states": ["active", "drafts", "review", "needs-changes", "rejected", "expired", "archived", "history", "empty"] },
    { "id": "bookmarks", "path": "/my/bookmarks", "family": "account", "auth": true, "states": ["collections", "posts", "creating", "empty"] },
    { "id": "recent", "path": "/my/recent", "family": "account", "auth": true, "states": ["ready", "empty"] },
    { "id": "wallet", "path": "/my/wallet", "family": "finance", "auth": true, "states": ["balance", "transactions", "payment", "failed"] },
    { "id": "finance-admin", "path": "/admin/finance", "family": "internal", "auth": true, "states": ["metrics", "payments", "refunds", "reconciliation", "settlements", "empty"] },
    { "id": "promotions", "path": "/my/promotions", "family": "monetization", "auth": true, "states": ["catalog", "entitlements", "checkout", "success", "failed"] },
    { "id": "monetization-admin", "path": "/admin/monetization", "family": "internal", "auth": true, "states": ["metrics", "products", "prices", "campaigns", "subscriptions"] },
    { "id": "business-center", "path": "/my/business", "family": "business", "auth": true, "states": ["overview", "verification", "branches", "team", "analytics", "billing"] },
    { "id": "business-team", "path": "/my/business/team", "family": "business", "auth": true, "states": ["members", "inviting", "accepted", "expired", "revoked"] },
    { "id": "storefront", "path": "/store/:slug", "family": "business", "auth": false, "states": ["loading", "published", "paused", "not-found"] },
    { "id": "business-admin", "path": "/admin/business", "family": "internal", "auth": true, "states": ["metrics", "verification-queue", "selected", "suspended", "empty"] },
    { "id": "platform-admin", "path": "/admin", "family": "internal", "auth": true, "states": ["overview", "health", "alerts", "reports", "configuration", "audit", "permission-denied"] },
    { "id": "product-analytics", "path": "/admin/analytics", "family": "internal", "auth": true, "states": ["overview", "funnel", "retention", "experiments", "guardrail-breached", "permission-denied"] },
    { "id": "risk-operations", "path": "/admin/risk", "family": "internal", "auth": true, "states": ["overview", "queue", "claimed", "challenge", "pending-approval", "resolved", "permission-denied"] },
    { "id": "sre-operations", "path": "/admin/sre", "family": "internal", "auth": true, "states": ["overview", "healthy", "budget-at-risk", "incident", "mitigating", "monitoring", "resolved", "permission-denied"] },
    { "id": "performance-operations", "path": "/admin/performance", "family": "internal", "auth": true, "states": ["overview", "healthy", "budget-breached", "load-running", "capacity-warning", "permission-denied"] },
    { "id": "resilience-operations", "path": "/admin/resilience", "family": "internal", "auth": true, "states": ["overview", "healthy", "degraded", "experiment-running", "failover", "recovery-drill", "permission-denied"] },
    { "id": "security-operations", "path": "/admin/security", "family": "internal", "auth": true, "states": ["overview", "scan-running", "finding-open", "sla-overdue", "release-blocked", "exception-review", "permission-denied"] },
    { "id": "settings", "path": "/my/settings", "family": "account", "auth": true, "states": ["preferences", "sessions", "active-session", "revoked-session", "privacy", "consent", "theme"] },
    { "id": "safety", "path": "/safety", "family": "trust", "auth": false, "states": ["index", "article", "report"] },
    { "id": "help", "path": "/help", "family": "support", "auth": false, "states": ["index", "search", "article", "ticket"] },
    { "id": "design-system", "path": "/system", "family": "internal", "auth": false, "states": ["tokens", "components", "motion"] }
  ],
  "overlays": [
    { "id": "city-picker", "type": "modal-bottom-sheet", "trigger": "location" },
    { "id": "category-picker", "type": "mega-menu-bottom-sheet", "trigger": "category" },
    { "id": "filters", "type": "side-panel-fullscreen", "trigger": "filter" },
    { "id": "district-picker", "type": "modal-bottom-sheet", "trigger": "district" },
    { "id": "contact", "type": "modal-bottom-sheet", "trigger": "contact" },
    { "id": "share", "type": "popover-bottom-sheet", "trigger": "share" },
    { "id": "report", "type": "step-modal", "trigger": "report" },
    { "id": "login", "type": "modal-fullscreen", "trigger": "protected-action" },
    { "id": "image-gallery", "type": "lightbox", "trigger": "media" },
    { "id": "confirm", "type": "alert-dialog", "trigger": "destructive-action" }
  ]
}

