{
  "version": "0.6.0",
  "components": [
    { "name": "Button", "variants": ["primary", "secondary", "ghost", "danger", "icon"], "states": ["default", "hover", "focus", "pressed", "loading", "disabled"] },
    { "name": "TextField", "variants": ["text", "search", "phone", "number", "textarea"], "states": ["empty", "filled", "focus", "error", "disabled"] },
    { "name": "SelectRow", "variants": ["plain", "icon", "description", "active"], "states": ["default", "hover", "focus", "disabled"] },
    { "name": "PostCard", "variants": ["grid", "list", "compact"], "states": ["loading", "ready", "bookmarked", "promoted", "without-image"] },
    { "name": "Chip", "variants": ["filter", "choice", "dismissible", "status"], "states": ["default", "selected", "disabled"] },
    { "name": "Modal", "variants": ["dialog", "sticky-footer", "fullscreen"], "states": ["opening", "open", "closing"] },
    { "name": "BottomSheet", "variants": ["content", "menu", "form"], "states": ["opening", "open", "dragging", "closing"] },
    { "name": "Toast", "variants": ["info", "success", "warning", "danger"], "states": ["visible", "dismissed"] },
    { "name": "Skeleton", "variants": ["text", "card", "avatar", "image"], "states": ["loading"] },
    { "name": "EmptyState", "variants": ["search", "account", "network", "permission"], "states": ["ready"] },
    { "name": "Header", "variants": ["desktop", "mobile", "detail"], "states": ["top", "sticky", "searching"] },
    { "name": "BottomNavigation", "variants": ["guest", "member"], "states": ["default", "active"] },
    { "name": "CitySelector", "variants": ["dialog", "bottom-sheet", "multi-city"], "states": ["loading", "ready", "empty", "limit"] },
    { "name": "Footer", "variants": ["desktop", "mobile"], "states": ["default"] },
    { "name": "UiState", "variants": ["loading", "error", "empty"], "states": ["default", "compact", "actionable"] },
    { "name": "CategorySidebar", "variants": ["desktop", "mobile-details"], "states": ["root", "branch", "selected"] },
    { "name": "ListingToolbar", "variants": ["desktop", "mobile"], "states": ["grid", "list", "sorted"] },
    { "name": "Pagination", "variants": ["pages", "load-more", "infinite"], "states": ["ready", "loading", "complete"] },
    { "name": "ClassifiedsMap", "variants": ["desktop", "mobile", "embedded"], "states": ["loading", "ready", "moving", "offline"] },
    { "name": "MapPostPreview", "variants": ["image", "without-image"], "states": ["opening", "selected", "closing"] },
    { "name": "SubmissionStepper", "variants": ["desktop", "mobile"], "states": ["pending", "active", "complete"] },
    { "name": "DynamicSubmissionForm", "variants": ["catalog-driven"], "states": ["ready", "invalid", "saving"] },
    { "name": "SubmissionPreview", "variants": ["with-media", "without-media"], "states": ["ready", "submitting", "success"] },
    { "name": "MediaUploader", "variants": ["image", "video", "mixed"], "states": ["hashing", "uploading", "processing", "ready", "failed", "rejected"] },
    { "name": "MyPostCard", "variants": ["post", "draft"], "states": ["published", "paused", "review", "rejected", "expired", "archived"] },
    { "name": "PostStatusChip", "variants": ["neutral", "success", "warning", "danger"], "states": ["ready"] },
    { "name": "PostHistoryPanel", "variants": ["dialog", "drawer"], "states": ["loading", "ready", "empty"] },
    { "name": "PostGallery", "variants": ["image", "video", "without-media"], "states": ["ready", "lightbox", "selected"] },
    { "name": "DynamicAttributeSummary", "variants": ["summary", "full"], "states": ["ready", "empty"] },
    { "name": "ApproximateLocationMap", "variants": ["circle"], "states": ["loading", "ready", "offline"] },
    { "name": "PostInteractionBar", "variants": ["desktop", "mobile"], "states": ["default", "bookmarked", "noted", "reported"] }
  ]
}

