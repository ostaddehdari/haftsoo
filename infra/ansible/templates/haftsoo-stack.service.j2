[Unit]
Description=Haftsoo application stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ haftsoo_root }}
EnvironmentFile={{ haftsoo_environment_file }}
ExecStart=/usr/bin/docker compose -f {{ haftsoo_compose_file }} up -d --remove-orphans
ExecStop=/usr/bin/docker compose -f {{ haftsoo_compose_file }} down
TimeoutStartSec=600
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
