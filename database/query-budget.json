{
  "version": "1.0.0",
  "defaultStatementTimeoutMs": 1000,
  "interactive": {
    "p95Ms": 200,
    "maximumRows": 100,
    "maximumSequentialScanRows": 10000
  },
  "background": {
    "p95Ms": 2000,
    "maximumRows": 5000,
    "statementTimeoutMs": 10000
  },
  "spatial": {
    "p95Ms": 500,
    "requiresBoundingBox": true,
    "requiredIndex": "gist"
  },
  "chat": {
    "p95MessageWriteMs": 120,
    "p95ConversationPageMs": 180,
    "maximumMessagePageRows": 100,
    "requiresSequenceCursor": true
  },
  "notifications": {
    "p95InboxMs": 180,
    "p95UnreadCountMs": 100,
    "maximumInboxRows": 100,
    "maximumDispatchBatch": 100,
    "requiresCursor": true
  },
  "review": {
    "explainFormat": "json",
    "requireAnalyzeOutsideProduction": true,
    "rejectUnboundedQueries": true
  }
}
