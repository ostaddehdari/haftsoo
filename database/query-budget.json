{
  "version": "1.0.0",
  "defaultStatementTimeoutMs": 1000,
  "interactive": {
    "p95Ms": 200,
    "maximumRows": 100,
    "maximumSequentialScanRows": 10000
  },
  "background": {
    "p95Ms": 2000,
    "maximumRows": 5000,
    "statementTimeoutMs": 10000
  },
  "spatial": {
    "p95Ms": 500,
    "requiresBoundingBox": true,
    "requiredIndex": "gist"
  },
  "chat": {
    "p95MessageWriteMs": 120,
    "p95ConversationPageMs": 180,
    "maximumMessagePageRows": 100,
    "requiresSequenceCursor": true
  },
  "crm": { "p95TicketQueueMs": 120, "p95Customer360Ms": 180, "maximumTicketRows": 100, "maximumTimelineRows": 50 },
  "notifications": {
    "p95InboxMs": 180,
    "p95UnreadCountMs": 100,
    "maximumInboxRows": 100,
    "maximumDispatchBatch": 100,
    "requiresCursor": true
  },
  "moderation": {
    "p95EvaluationMs": 800,
    "p95QueueMs": 200,
    "maximumCandidateRows": 200,
    "duplicateWindowHours": 24,
    "requiresModelVersion": true,
    "requiresExplainableSignals": true,
    "p95OperationsQueueMs": 180,
    "maximumOperationsRows": 100,
    "claimLeaseMinutes": 15,
    "requiresSlaIndex": true
  },
  "review": {
    "explainFormat": "json",
    "requireAnalyzeOutsideProduction": true,
    "rejectUnboundedQueries": true
  }
}
