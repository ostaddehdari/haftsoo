{
  "version": "1.0.0",
  "model": "RBAC-with-scoped-constraints",
  "defaultDecision": "deny",
  "roles": [
    { "id": "guest", "principalTypes": ["anonymous", "user"], "permissions": ["listing:read"] },
    { "id": "member", "principalTypes": ["user"], "permissions": ["listing:read", "listing:create", "profile:self:read", "profile:self:update", "chat:self:use", "monetization:self:purchase", "entitlement:self:use"] },
    { "id": "business_owner", "principalTypes": ["business"], "permissions": ["listing:read", "listing:create", "listing:business:manage", "profile:self:read", "profile:self:update", "monetization:business:purchase", "entitlement:business:use"] },
    { "id": "moderator", "principalTypes": ["workforce"], "permissions": ["listing:read", "moderation:queue:read", "moderation:evidence:read", "moderation:decision:create", "moderation:appeal:read", "moderation:case:claim", "moderation:case:release", "moderation:report:read"] },
    { "id": "moderation_lead", "principalTypes": ["workforce"], "permissions": ["listing:read", "moderation:queue:read", "moderation:evidence:read", "moderation:decision:create", "moderation:appeal:decide", "moderation:model:read", "moderation:metrics:read", "moderation:case:claim", "moderation:case:release", "moderation:case:escalate", "moderation:report:read", "moderation:sla:read", "moderation:quality:review"] },
    { "id": "support_agent", "principalTypes": ["workforce"], "permissions": ["listing:read", "support:case:read", "support:case:update", "support:case:assign", "support:interaction:create", "support:task:manage", "profile:masked:read"] },
    { "id": "support_lead", "principalTypes": ["workforce"], "permissions": ["listing:read", "support:case:read", "support:case:update", "support:case:assign", "support:interaction:create", "support:task:manage", "support:sla:read", "support:macro:manage", "support:quality:review", "profile:masked:read"] },
    { "id": "finance_operator", "principalTypes": ["workforce"], "permissions": ["finance:ledger:read", "finance:payment:read", "finance:reconciliation:execute", "finance:refund:request"] },
    { "id": "finance_lead", "principalTypes": ["workforce"], "permissions": ["finance:ledger:read", "finance:payment:read", "finance:reconciliation:execute", "finance:refund:request", "finance:refund:approve", "finance:provider:manage", "finance:metrics:read"] },
    { "id": "monetization_manager", "principalTypes": ["workforce"], "permissions": ["monetization:catalog:read", "monetization:catalog:manage", "monetization:price:publish", "monetization:subscription:manage", "monetization:metrics:read"] },
    { "id": "marketing_manager", "principalTypes": ["workforce"], "permissions": ["monetization:catalog:read", "monetization:campaign:manage", "monetization:coupon:manage", "monetization:metrics:read"] },
    { "id": "platform_admin", "principalTypes": ["workforce"], "permissions": ["platform:configuration:manage", "audit:read", "iam:assignment:manage"] },
    { "id": "service", "principalTypes": ["service"], "permissions": ["service:internal:invoke"] }
  ],
  "scopes": ["self", "business", "tenant", "assigned-queue", "platform"],
  "separationOfDuties": [
    ["moderator", "platform_admin"],
    ["finance_operator", "platform_admin"],
    ["finance_operator", "finance_lead"],
    ["monetization_manager", "finance_lead"],
    ["moderator", "moderation_lead"]
  ]
}
